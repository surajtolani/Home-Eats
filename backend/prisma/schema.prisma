// Home Eats backend — Prisma schema for accounts/friends/groups (Phase 1 of
// the accounts feature; see backend/README.md for the full picture and
// migration instructions). Modeled explicitly after Splitwise: a personal
// friends list, plus groups ("households", but also e.g. "our Peru trip")
// built from that friends list, where a person can belong to several groups
// at once — nothing here assumes one user has only one group.
//
// A note on the Prisma version pin: as of this writing, Prisma's *current*
// major version (7) removed the ability to put a datasource `url` here and
// instead requires an explicit driver adapter (e.g. `@prisma/adapter-pg`)
// wired up in application code just to run `prisma migrate`/connect the
// client — a bigger, newer surface than this task needs, and one this
// sandbox has no live Postgres to test against. Prisma 6.x (still an
// actively-published, fully supported prior major, not an abandoned one)
// keeps the classic, simpler model used below: a schema-defined `url =
// env("DATABASE_URL")` and a zero-argument `new PrismaClient()` that reads
// it automatically. See backend/package.json, which pins both `prisma` and
// `@prisma/client` to 6.19.3 for this reason. Revisit the Prisma 7 driver
// adapter approach in a later pass if there's a real reason to upgrade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per phone number that has ever verified via Twilio. displayName
// is null until the person sets it post-verification (see PATCH /me) — the
// app can still function with a phone-number-only account in the meantime,
// e.g. to accept a friend request that arrived before they picked a name.
model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  // `displayName` is the freeform name shown to friends/groups (what
  // `AccountSignInView`'s post-signup name step already sets) — left
  // exactly as-is. These four are additional, separately-optional profile
  // fields (nullable, same "not set until someone fills them in" story as
  // displayName always had) — a fuller profile someone can fill in later
  // from a dedicated Edit Profile screen, not required at signup.
  displayName String?
  firstName   String?
  lastName    String?
  city        String?
  country     String?
  createdAt   DateTime @default(now())

  // Friend requests this user sent / received. A Friendship is queryable
  // from either side by combining these two relations (see routes/friends.js).
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipRecipient")

  groupMemberships GroupMembership[]
  createdGroups    Group[]           @relation("GroupCreator")

  sentInvites Invite[] @relation("InviteSender")

  // Recipe sharing (Phase 2a) — see the Recipe/RecipeShare doc comments
  // below for the full model.
  ownedRecipes         Recipe[]      @relation("RecipeOwner")
  recipeSharesReceived RecipeShare[] @relation("RecipeShareUserTarget")
  recipeSharesSent     RecipeShare[] @relation("RecipeShareSharer")

  // Group meal planning / grocery lists (Phase 3) — see the doc comments on
  // PlannedMeal, MealSuggestion, MealSuggestionVote, and GroupGroceryItem
  // below for the full model.
  decidedMealPlans        PlannedMeal[]        @relation("PlannedMealDecidedBy")
  proposedMealSuggestions MealSuggestion[]     @relation("MealSuggestionProposedBy")
  mealSuggestionVotes     MealSuggestionVote[]
  addedGroceryItems       GroupGroceryItem[]

  // Group grocery "My Layout" / staples (Phase 4) — see the doc comments on
  // GroupStoreAisle and GroupStapleItem below.
  addedGroupStaples GroupStapleItem[]

  @@index([phoneNumber])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A directional request (requester -> recipient) that becomes a mutual
// friendship once ACCEPTED. Only one row should ever exist for a given
// unordered pair of users — application code (routes/friends.js) enforces
// this by checking both directions before inserting, since a plain unique
// constraint here can only cover one direction at the database level; the
// `@@unique([requesterId, recipientId])` below still catches the exact-same-
// direction double-submit case outright.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

// The "household" or "trip" — deliberately generic, name is user-chosen.
// createdByUserId is kept mainly for provenance/display ("created by...") —
// it's what the Phase 3 role-backfill migration used to decide who starts
// MANAGER (see the GroupRole/GroupMembership doc comments below), but
// nothing at runtime keeps a membership's `role` tied to it after that: a
// MANAGER can leave or be demoted-by-a-future-endpoint independently of
// whether they happen to be group.createdByUserId. Nullable, with
// `onDelete: SetNull` rather than `Cascade`: the creator is just the one who
// happened to tap "Create" — deleting their User row (no such route exists
// yet, but will) must not take the whole Group down with it and thereby
// destroy every other member's membership, invites, and recipe shares tied
// to it. SetNull just clears who created it; the group and its remaining
// members are unaffected.
model Group {
  id              String   @id @default(uuid())
  name            String
  createdByUserId String?
  createdAt       DateTime @default(now())

  createdBy    User?             @relation("GroupCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships  GroupMembership[]
  invites      Invite[]
  recipeShares RecipeShare[]

  // Group meal planning / grocery lists (Phase 3) — see the doc comments on
  // PlannedMeal, MealSuggestion, and GroupGroceryItem below.
  plannedMeals    PlannedMeal[]
  mealSuggestions MealSuggestion[]
  groceryItems    GroupGroceryItem[]

  // Group grocery "My Layout" / staples / history (Phase 4) — see the doc
  // comments on GroupStoreAisle, GroupStapleItem, and
  // GroupGroceryHistoryEntry below.
  storeAisles    GroupStoreAisle[]
  staples        GroupStapleItem[]
  groceryHistory GroupGroceryHistoryEntry[]
}

// MANAGER/PARTICIPANT — the two-tier permission model added in Phase 3 for
// shared meal planning and grocery lists ("Managers can add stuff to the
// meal plans etc, participants can suggest things to vote or suggest a
// recipe etc," per the feature spec). A MANAGER can decide meals and
// grocery-list items directly; a PARTICIPANT can only propose/suggest
// (a meal suggestion pending a vote, or a grocery item in the SUGGESTED
// section) — see routes/groupMealPlan.js and routes/groupGrocery.js for
// exactly which routes require which role. Deliberately just these two
// tiers, and deliberately no promote/demote-role endpoint yet (see
// backend/README.md) — that's a reasonable follow-up once real usage shows
// it's needed, not something this phase needs to solve.
enum GroupRole {
  MANAGER
  PARTICIPANT
}

// The many-to-many join between User and Group — this is what makes
// "overlapping groups" work: a user can have many GroupMembership rows
// (one per group they're in), and a group can have many members. Nothing
// in this schema or the route handlers assumes a user has at most one.
//
// `role` (added in Phase 3): a group's creator's own membership row starts
// MANAGER; every membership added afterwards — at creation via
// `memberUserIds`, or later via POST /groups/:groupId/invite — starts
// PARTICIPANT (see routes/groups.js). The migration that added this column
// backfilled it the same way for every pre-existing membership: the row
// matching `group.createdByUserId` became MANAGER, everything else
// PARTICIPANT — and since `createdByUserId` is nullable (a group whose
// creator's account has since been deleted — see the Group doc comment
// above), a group with no known creator anymore just leaves every one of
// its existing memberships at the column default (PARTICIPANT) rather than
// guessing which member should be promoted.
model GroupMembership {
  id       String    @id @default(uuid())
  userId   String
  groupId  String
  role     GroupRole @default(PARTICIPANT)
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

enum InviteStatus {
  PENDING
  RESOLVED
  CANCELLED
}

// Invites someone by phone number who isn't a User yet. `groupId` is null
// for a plain "become my friend" invite, or set for "join my group"
// (routes/groups.js's POST /groups/:groupId/invite). When that phone number
// eventually verifies (POST /auth/verify-code), every PENDING Invite for it
// gets the inviter turned into an ordinary PENDING Friendship (an incoming
// request the new user sees and can accept/decline like any other — see
// GET /friends' incomingRequests) — deliberately NOT auto-accepted, and
// NOT auto-joined to `groupId`'s Group yet even if set: an invite is a
// strong signal, but the invited person still has to actually agree before
// anything is granted. The Invite row itself is left PENDING at signup and
// only resolves once that Friendship is actually accepted or declined (see
// `resolveInvitesForAcceptedFriendship`/`cancelInvitesForDeclinedFriendship`
// in routes/friends.js): accepting moves it to RESOLVED and, if `groupId`
// was set, creates the GroupMembership at that moment; declining moves it
// to CANCELLED and grants nothing. See routes/auth.js and routes/friends.js.
model Invite {
  id                 String       @id @default(uuid())
  invitingUserId     String
  invitedPhoneNumber String
  groupId            String?
  status             InviteStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  resolvedAt         DateTime?

  invitingUser User   @relation("InviteSender", fields: [invitingUserId], references: [id], onDelete: Cascade)
  group        Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([invitedPhoneNumber, status])
  @@index([invitingUserId])
}

// --- Recipe sharing (Phase 2a) ------------------------------------------
// Recipes move from purely on-device (SwiftData, one phone) to something
// that can live on the backend and be shared between people — see
// backend/README.md's "Recipe sharing" section for the full picture and
// routes/recipeLibrary.js for the API. Field names below deliberately
// mirror the iOS `Recipe`/`RecipeIngredientEntry` SwiftData models
// (HomeEats/Models/Recipe.swift, HomeEats/Models/RecipeIngredientEntry.swift)
// so wiring the app up to this API later is a straightforward mapping, not
// a redesign. A few iOS-only fields have no counterpart here on purpose:
// `source`/`sourceURL`/`imageName`/`tags`/`isFavorite`/`isSavedToCollection`/
// `createdByMemberID` are either purely device-local concerns (a local
// family-member id) or not yet needed for sharing itself — that's for a
// later iOS-wiring task to reconcile, not this one. `photoData` is the one
// exception: see `Recipe.photoBase64` below — a recipe's user-picked photo
// *is* wired through to sharing, since a shared recipe with no photo at all
// was the actual bug this field exists to fix (see the recipe-sharing task
// that added it, and its own doc comment on `photoBase64`).
enum RecipeVisibility {
  PRIVATE
  SHARED
  // Deliberately no PUBLIC value yet — this phase is "private + shared with
  // specific friends/groups only" (see backend/README.md); there's no
  // public/community recipe library, and therefore nothing that would ever
  // set a PUBLIC visibility. Adding one later is just adding a third value
  // to this enum plus a route that can set it — not a rework of this model.
}

// A recipe someone owns. `instructions` is a native Postgres text array
// (Prisma's `String[]` on the postgresql provider), matching the iOS
// model's `[String]` of ordered step strings exactly — no extra JSON
// encoding/decoding needed on either side.
model Recipe {
  id           String           @id @default(uuid())
  ownerId      String
  title        String
  summary      String?
  instructions String[]
  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  visibility   RecipeVisibility @default(PRIVATE)
  // The iOS `Recipe.photoData`'s bytes, base64-encoded — stored as plain
  // text rather than a Postgres `bytea` column so `serializeRecipe(...)` in
  // routes/recipeLibrary.js can hand it straight to `res.json(...)` with no
  // extra encode/decode step at the API boundary (a `bytea` would come back
  // from `pg`/Prisma as either a Buffer needing manual base64 conversion or
  // Postgres's own `\x`-prefixed hex text, neither of which is what a JSON
  // API consumer wants). `@db.Text` rather than the default `String`
  // (`varchar`, unbounded here but still worth being explicit) since this
  // column can legitimately hold a few MB of text — see
  // `MAX_PHOTO_BYTES_DECODED` in routes/recipeLibrary.js for the actual
  // server-enforced cap, chosen with the size/bloat tradeoff this comment
  // describes in mind.
  //
  // Nullable, and expected to be null for most rows: only recipes with a
  // user-picked photo (`RecipeSource.manual`/`.imported` with `photoData`
  // set — see that property's doc comment in HomeEats/Models/Recipe.swift)
  // ever populate this; a `.library` recipe's bundled-asset-name photo
  // (`imageName`) has no bytes to send at all and stays purely local, same
  // as before this field existed.
  //
  // Base64-in-JSON costs ~33% more bytes over the wire than the raw photo
  // would, and there's no separate thumbnail column — every viewer of a
  // recipe with a photo pays that recipe's full photo size on every fetch,
  // not just once. Judged an acceptable tradeoff for this app's actual
  // scale (a household/friend-group app sharing a handful of recipes at a
  // time, not a photo-sharing platform serving many viewers per photo per
  // minute) given the iOS upload path (see `RecipeSharePickerSheet`) already
  // downsizes to a small JPEG before this column is ever written — the same
  // `ImageResizing.downsized(...)` cap already applied to every locally-
  // captured recipe photo (`RecipeEditorView`), so sharing a recipe adds no
  // new "how big can this get" case beyond what local storage already
  // accepts. Revisit (a real object-store + CDN URL instead of inline
  // base64) only if this app ever grows past that household/friend-group
  // scale — flagged here explicitly for whoever owns that call next, not
  // decided unilaterally by this comment.
  photoBase64  String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  owner       User               @relation("RecipeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  shares      RecipeShare[]

  // Group meal planning (Phase 3) — a recipe-based PlannedMeal/
  // MealSuggestion references back to the same Recipe row it was decided/
  // suggested from (see those models' doc comments below). Not scoped to
  // sharing/visibility at the schema level; routes/groupMealPlan.js enforces
  // that the caller can actually see a recipe (owner, direct share, or a
  // shared-with group) before letting it be planned or suggested.
  plannedMeals    PlannedMeal[]
  mealSuggestions MealSuggestion[]

  @@index([ownerId])
}

// One ingredient line on a Recipe — mirrors `RecipeIngredientEntry`'s
// name/quantity/unit shape. `quantity` is nullable because plenty of real
// ingredient lines have no numeric amount at all (e.g. "salt to taste").
// `sortIndex` preserves the order ingredients were entered in, since a SQL
// table (unlike the iOS model's plain `[RecipeIngredientEntry]` array) has
// no inherent row order. Deliberately does NOT carry the iOS model's
// `category` (a GroceryCategory, purely a shopping-list concern) or
// `rawText`/formatting fields — those are derived/display concerns the
// iOS-wiring task can keep computing client-side from name/quantity/unit.
model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String
  name      String
  quantity  Float?
  unit      String?
  sortIndex Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

// A single "this recipe is shared with X" grant — either a specific person
// (sharedWithUserId) or a whole group (sharedWithGroupId), never both/
// neither. Prisma/Postgres have no clean way to express "exactly one of
// these two nullable columns is set" as a schema-level constraint, so that
// rule is enforced in routes/recipeLibrary.js instead (400 if violated).
// The two @@unique constraints below still give a real DB-level guarantee
// for the case each covers: Postgres treats NULL as distinct from any other
// NULL in a unique index, so `@@unique([recipeId, sharedWithUserId])` only
// ever collides for two rows that are both non-null *and* equal — i.e. it
// stops a duplicate direct-user share without also (wrongly) treating two
// unrelated group shares on the same recipe as a collision, and the same
// reasoning applies symmetrically to the groupId constraint.
model RecipeShare {
  id                String   @id @default(uuid())
  recipeId          String
  sharedWithUserId  String?
  sharedWithGroupId String?
  sharedByUserId    String
  createdAt         DateTime @default(now())

  recipe          Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  sharedWithUser  User?  @relation("RecipeShareUserTarget", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithGroup Group? @relation(fields: [sharedWithGroupId], references: [id], onDelete: Cascade)
  sharedByUser    User   @relation("RecipeShareSharer", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([recipeId, sharedWithUserId])
  @@unique([recipeId, sharedWithGroupId])
  @@index([sharedWithUserId])
  @@index([sharedWithGroupId])
}

// --- Group meal planning (Phase 3) --------------------------------------
// A group's single shared meal plan: everyone in the group sees the same
// PlannedMeal/MealSuggestion rows (contrast with Recipe/RecipeShare above,
// which is "my recipe, shared with specific people/groups" — this is
// "belongs to the group outright," no separate sharing step). See
// backend/README.md's "Group meal planning" section and
// routes/groupMealPlan.js for the API. `slot`'s case names deliberately
// mirror the iOS `MealSlot` enum's case names exactly (breakfast ->
// BREAKFAST, etc. — see HomeEats/Models/MealSlot.swift) so a later iOS-
// wiring task has a direct 1:1 mapping rather than a lookup table.
enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  OTHER
}

// A single already-decided meal for a group's shared plan — the group-
// scoped, MANAGER-only-to-create counterpart of the iOS `PlannedMeal`
// SwiftData model (HomeEats/Models/PlannedMeal.swift), which this mirrors
// field-for-field where it makes sense (date/slot/isOrderIn/decidedAt).
// Every row is either recipe-based (`recipeId` set, referencing an existing
// row in the recipe-library — see the Recipe model above and
// routes/groupMealPlan.js, which requires the recipe to already exist and
// be visible to the caller) or a restaurant/order-in meal (`restaurantName`
// set instead). Exactly one of `recipeId`/`restaurantName` must be set,
// never both/neither — same "Prisma/Postgres can't express this as a
// schema constraint" situation as RecipeShare above, so it's enforced in
// routes/groupMealPlan.js instead. v1 deliberately has no backend
// `Restaurant` model at all (see the feature spec) — `restaurantName` is
// just a plain string, no FK, matching `isOrderIn`'s existing meaning on
// the iOS model (dining at vs. ordering in from the same place).
//
// `recipeId`'s `onDelete: SetNull` (rather than Cascade) is the same
// tradeoff as `Group.createdByUserId` above: if the recipe behind a
// decided meal is later deleted by its owner, this row survives (so a
// group's meal-plan history isn't silently destroyed by an unrelated
// delete elsewhere) with `recipeId` cleared — the one case where a row can
// end up with both `recipeId` and `restaurantName` null; routes/clients
// reading this data should treat that combination as "recipe no longer
// available" rather than crashing on it.
model PlannedMeal {
  id              String   @id @default(uuid())
  groupId         String
  date            DateTime
  slot            MealSlot
  recipeId        String?
  restaurantName  String?
  isOrderIn       Boolean  @default(false)
  decidedByUserId String
  decidedAt       DateTime @default(now())

  group         Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipe        Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  decidedByUser User    @relation("PlannedMealDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, date])
  @@index([recipeId])
}

// A recipe/restaurant proposed for a given date+slot, pending a vote —
// the group-scoped counterpart of the iOS `MealSuggestion` SwiftData model
// (HomeEats/Models/MealSuggestion.swift). Any member may propose one (see
// routes/groupMealPlan.js); a MANAGER can adopt it into a real PlannedMeal
// (POST .../suggestions/:id/adopt, inside a transaction that creates the
// PlannedMeal and deletes this row) or it can be withdrawn by its proposer
// or removed by a MANAGER. Same recipe-or-restaurant shape and the same
// `onDelete: SetNull` reasoning on `recipeId` as PlannedMeal above.
//
// Votes are their own join table (`MealSuggestionVote`) rather than a
// plain integer counter or an array column: the iOS `MealSuggestion` model
// tracks voters as `votedMemberIDs: [UUID]` specifically so the UI can show
// "did I already vote for this" per suggestion, not just a raw count — a
// real table with `@@unique([suggestionId, userId])` gives that same
// per-user answer as a simple existence check (and toggling a vote is then
// just an insert-or-delete on one row) instead of reading/rewriting a JSON-
// ish array column on every vote.
model MealSuggestion {
  id               String   @id @default(uuid())
  groupId          String
  date             DateTime
  slot             MealSlot
  recipeId         String?
  restaurantName   String?
  isOrderIn        Boolean  @default(false)
  proposedByUserId String
  createdAt        DateTime @default(now())

  group          Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipe         Recipe?              @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  proposedByUser User                 @relation("MealSuggestionProposedBy", fields: [proposedByUserId], references: [id], onDelete: Cascade)
  votes          MealSuggestionVote[]

  @@index([groupId])
  @@index([groupId, date])
  @@index([recipeId])
}

// One user's vote for one MealSuggestion — see that model's doc comment
// above for why this is a real join table rather than a counter/array
// column. `@@unique([suggestionId, userId])` is what makes "toggle my own
// vote" a clean upsert-or-delete in routes/groupMealPlan.js, and also
// guarantees one member can never double-count their own vote.
model MealSuggestionVote {
  id           String   @id @default(uuid())
  suggestionId String
  userId       String
  createdAt    DateTime @default(now())

  suggestion MealSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@index([suggestionId])
  @@index([userId])
}

// --- Group grocery list (Phase 3) ---------------------------------------
// A group's single shared grocery list — same "belongs to the group
// outright, not separately shared" relationship to Group as PlannedMeal/
// MealSuggestion above. See backend/README.md's "Group grocery list"
// section and routes/groupGrocery.js for the API.
//
// `category`'s case names mirror the iOS `GroceryCategory` enum's case
// names exactly (produce -> PRODUCE, dairyAndEggs -> DAIRY_AND_EGGS, etc.
// — see HomeEats/Models/GroceryCategory.swift) so a later iOS-wiring task
// has a direct 1:1 mapping. Deliberately does NOT carry that enum's
// `guess`/`symbolName`/`sortIndex` display logic — those stay client-side,
// same reasoning as RecipeIngredient leaving out `category`/`rawText`
// above.
enum GroceryCategory {
  PRODUCE
  DAIRY_AND_EGGS
  MEAT_AND_SEAFOOD
  BAKERY
  PANTRY
  FROZEN
  BEVERAGES
  SNACKS
  HOUSEHOLD
  OTHER
}

// `section`'s case names mirror the iOS `GroceryListSection` enum's
// *current* semantics, not its full raw case list: `GroceryListSection`
// still technically has a `.rejected` case in Swift, but it's vestigial —
// kept only for `RejectedGroceryItemCleanup`'s one-time migration of old
// rows, per that file's own doc comment ("Rejecting now deletes the row
// outright instead ... nothing new will ever land in `.rejected`"). This
// enum deliberately has no REJECTED value to match: "reject" here (see
// DELETE /groups/:groupId/grocery/:id in routes/groupGrocery.js) means
// deleting the row outright, same as the already-fixed local behavior.
// suggested -> SUGGESTED, thisWeek -> THIS_WEEK, staples -> STAPLES.
enum GroupGrocerySection {
  SUGGESTED
  THIS_WEEK
  STAPLES
}

// A single shared grocery-list line. Named `GroupGroceryItem` (rather than
// reusing `GroceryItem`) to keep it visibly distinct from the iOS
// `GroceryItem` SwiftData model it parallels: this is deliberately a
// smaller shape — no `weekStartDate`/`selectedProductOptionID`/
// `quantityCount`/`categoryManuallySet`/`layoutOrderIndex`. `orderIndex` is
// a `Float` (not `Int`) for the same reason as the iOS model's own
// `orderIndex`: reordering can slot an item between two existing ones (new
// value = the average of its neighbors) without renumbering every other row
// in the category.
//
// UPDATE (Phase 4): this originally had no group-scoped "My Layout"
// counterpart at all — see the superseded note that used to live here, and
// backend/README.md's "Group grocery list" section, which predates this.
// `aisleId`/`aisleManuallySet` below are that counterpart, added alongside
// GroupStoreAisle rather than as a separate join table — see that model's
// doc comment for the full reasoning (in short: unlike the iOS
// `ItemAisleAssignment`, which is keyed by canonical item *name* so a
// placement survives an item's `GroceryItem` row being regenerated,
// `GroupGroceryItem` rows are never regenerated — they live exactly as long
// as the row itself, created once by POST and only ever mutated or deleted
// — so a plain FK column directly on this row loses nothing a name-keyed
// join would have given us, while avoiding porting the iOS canonicalizer's
// pluralization logic server-side just to key a join table).
model GroupGroceryItem {
  id               String              @id @default(uuid())
  groupId          String
  name             String
  category         GroceryCategory
  section          GroupGrocerySection
  quantityText     String              @default("")
  isChecked        Boolean             @default(false)
  orderIndex       Float               @default(0)
  // Where this item sits in "My Layout" — mirrors the iOS
  // `ItemAisleAssignment.aisleID` field exactly (including `null` being a
  // meaningful, explicit "put this in Unsorted" rather than "no opinion").
  // The `null`-is-meaningful vs. `null`-is-"never chosen" ambiguity a plain
  // nullable FK can't express on its own is resolved by `aisleManuallySet`
  // below, the same way iOS resolves it by row-existence instead (see
  // GroupStoreAisle's doc comment for the full reasoning on why this file
  // uses a flag instead of that same row-existence trick).
  aisleId          String?
  // False until someone explicitly places this item (including explicitly
  // choosing "Unsorted", i.e. `aisleId: null` with this `true`) — while
  // false, `aisleId` is not meaningful and a client should fall back to
  // whichever `GroupStoreAisle` has `linkedCategory == category`, exactly
  // like `GroceryListView.resolvedAisleID` does locally. This is what makes
  // a fresh group's "My Layout" open already grouped by category instead of
  // one giant "Unsorted" bucket, without this table needing to know that
  // fallback itself (see the GroupStoreAisle doc comment for where the
  // fallback aisles actually come from).
  aisleManuallySet Boolean             @default(false)
  addedByUserId    String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedByUser User             @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)
  // `onDelete: SetNull` is a backstop only — deleting an aisle should also
  // flip `aisleManuallySet` back to `false` on every item that pointed at
  // it (so those items fall back to their category's default aisle again,
  // not silently become "explicitly Unsorted"), and a plain FK action can't
  // touch that second column. routes/groupGroceryAisles.js's DELETE handler
  // does that reset itself, inside the same transaction as the aisle
  // delete; this `SetNull` only matters if some future code path deletes a
  // `GroupStoreAisle` row without going through that route.
  aisle       GroupStoreAisle? @relation(fields: [aisleId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([groupId, section])
  @@index([groupId, aisleId])
}

// --- Group grocery "My Layout" / staples / history (Phase 4) -----------
// Group-scoped counterparts of the local, on-device-only `StoreAisle`/
// `ItemAisleAssignment`, `StapleItem`, and `HistoricalGroceryItem` SwiftData
// models — see backend/README.md's "Group grocery list" section for the
// full picture, HomeEats/Models/StoreAisle.swift /
// HomeEats/Models/StapleItem.swift / HomeEats/Models/HistoricalGroceryItem.swift
// for what each is mirroring, and routes/groupGroceryAisles.js /
// routes/groupGroceryStaples.js for the API (the history endpoint lives in
// routes/groupGrocery.js itself instead — see GroupGroceryHistoryEntry's
// doc comment below for why).
//
// A group's "My Layout" — a household-defined arrangement of the shared
// list into the aisles of their actual store, independent of the fixed
// `GroceryCategory` list — same idea as iOS `StoreAisle`, just scoped to a
// `Group` instead of one phone's local storage. `linkedCategory` is set
// only for the ten starter aisles this feature seeds once per group (see
// the seeding note below); renaming a starter aisle keeps its automatic
// membership since matching is by `linkedCategory`, not `name` — same
// reasoning as the iOS doc comment on this field.
//
// **Default seeding, and how it differs from iOS's mechanism (read this
// before wiring up the iOS side later):** locally, `SampleDataSeeder` seeds
// the ten starter aisles once, up front, the moment the app launches for
// the first time — there's a single on-device process with an obvious
// "first launch" moment to hook. A multi-tenant backend has no equivalent
// moment for "this group's first use" to hook automatically (there's
// deliberately no seeding added to `POST /groups` in routes/groups.js — see
// this task's own constraints on which files may change). Instead,
// `GET /groups/:groupId/grocery/aisles` seeds this group's ten starter
// aisles the first time *it* is called for a group with zero
// `GroupStoreAisle` rows — same "only while completely empty" guard as
// `seedDefaultLayoutAislesIfNeeded`, just lazily triggered by the first
// read instead of by process launch. Practically this means: a group whose
// "My Layout" tab is never opened has zero aisle rows (fine — nothing reads
// them), and the *first* `GET .../grocery/aisles` call for a group
// populates the same ten aisles iOS would have seeded on first launch, in
// the same order. This is the one piece of this feature that a later
// iOS-wiring task needs to actually call (not just read the response of)
// for the "My Layout" tab to open pre-grouped instead of empty — flagged
// here and in backend/README.md.
model GroupStoreAisle {
  id             String           @id @default(uuid())
  groupId        String
  name           String
  // A `Float`, not the iOS model's `Int` — deliberately matching this
  // codebase's own established `GroupGroceryItem.orderIndex` convention
  // (reorder-by-inserting-between-neighbors, no bulk renumber-everything
  // endpoint needed) rather than iOS's `AislesManagerView.move`, which
  // renumbers every row 0..n-1 on every drag. Both land on the same visible
  // ordering; this just needs one PATCH per move instead of one per row.
  sortIndex      Float            @default(0)
  linkedCategory GroceryCategory?
  createdAt      DateTime         @default(now())

  group Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items GroupGroceryItem[]

  @@index([groupId])
  @@index([groupId, sortIndex])
}

// A group's standing "staples" list — recurring items the household always
// needs (milk, paper towels, ...), independent of any recipe. Mirrors the
// iOS `StapleItem` model field-for-field. `isActive` is carried over for
// interface parity with iOS (and because a household may still want to
// "pause" a staple without deleting its `defaultQuantityText`/history), but
// see routes/groupGroceryStaples.js's own doc comment for why toggling it
// currently has no downstream effect here — deliberately, matching what the
// local app itself actually does today.
//
// Distinct from the pre-existing `GroupGrocerySection.STAPLES` value on
// `GroupGroceryItem` (Phase 3, unchanged by this feature): that's a tag on
// one specific line already on the live list (mirroring iOS's
// `GroceryListSection.staples`, still reachable from `AddGroceryItemSheet`
// today); this is the separate standing *template* list those lines get
// manually copied from (mirroring iOS's separate `StapleItem` model) — the
// same two-concepts-coexisting shape iOS itself has, not a rename or a
// replacement of the Phase 3 section value.
model GroupStapleItem {
  id                  String          @id @default(uuid())
  groupId             String
  name                String
  category            GroceryCategory
  defaultQuantityText String?
  isActive            Boolean         @default(true)
  addedByUserId       String
  createdAt           DateTime        @default(now())

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedByUser User  @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// "Things this group has bought before," for one-tap re-adding — the
// group-scoped counterpart of the iOS `HistoricalGroceryItem` catalog.
//
// **Why this is its own table instead of a query derived from
// `GroupGroceryItem`** (the simpler default this feature's spec correctly
// prefers, and the one to reach for first for anything not already proven
// otherwise): `GroupGroceryItem` rows are ordinary, hard-deleted when
// they're removed from the list — and per `routes/groupGrocery.js`'s own
// `DELETE` doc comment, "we bought it" is an established, everyday reason a
// `THIS_WEEK`/`STAPLES` row gets deleted, not an edge case. A query over
// *currently-existing* rows would therefore lose an item's name from
// "history" at the exact moment someone finishes buying it and clears it
// off the list — the one moment this feature most needs to remember it. A
// derived query genuinely can't express "remember this even after the row
// it came from is gone," so a small durable table earns its keep here
// rather than being redundant bookkeeping to keep in sync — it's populated
// automatically, at exactly one trigger point (see below), by the same
// request that would otherwise lose the information, so there's no
// separate sync step to drift.
//
// The trigger, mirroring iOS's own `GroceryItemRow.recordAsHistorical`
// exactly: `routes/groupGrocery.js`'s `PATCH .../grocery/:id` writes one of
// these (upserted, so it's a no-op if already known) whenever `isChecked`
// transitions `false` -> `true` on a `GroupGroceryItem` — "checked off" is
// this app's stand-in for "actually bought," same as locally. Recording on
// `isChecked` rather than on every create/delete deliberately keeps a
// `SUGGESTED` item that got rejected (deleted without ever being checked
// off) out of "history" — it was proposed, never bought, and shouldn't come
// back as a one-tap "we've bought this before" suggestion.
//
// `normalizedName` (lowercased/trimmed) backs `@@unique([groupId,
// normalizedName])`, giving a real DB-level guarantee against the same item
// getting two entries — a deliberately simpler dedupe than the iOS
// canonicalizer's pluralization-aware `canonicalKey` (which is what the
// `GroupGroceryItem`/`GroupStoreAisle` doc comments above explain avoiding
// porting server-side); `name` keeps the first-seen display casing, same
// as iOS's own `HistoricalGroceryItem.name`.
model GroupGroceryHistoryEntry {
  id             String          @id @default(uuid())
  groupId        String
  name           String
  normalizedName String
  category       GroceryCategory
  createdAt      DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, normalizedName])
  @@index([groupId])
}
