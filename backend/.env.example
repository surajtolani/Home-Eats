# Copy this file to .env for local development (never commit the real .env).
# In production (Render), set this as an actual environment variable in the
# service's dashboard instead — see README.md.

GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
PORT=4000

# Optional: powers GET /recipes/web-search (real web results in the iOS
# app's Recipes search). Everything else works fine without these — see
# README.md's "3. Deploy" section for how to get them.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Accounts / friends / groups (see README.md's "Accounts, friends, and
# groups" section for full setup steps). The server now calls
# prisma.$connect() before it starts listening, so it will refuse to start
# at all without a reachable DATABASE_URL — even if you only care about the
# restaurant/recipe routes above.
DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
JWT_SECRET=

# Push notifications (a friend request, a group invite — see lib/apns.js).
# Optional: everything works without these (device-token registration
# still succeeds), there's just nothing to actually deliver a push until
# they're set. All four come from the Apple Developer account this app's
# bundle id (family.homeeats.app) belongs to.
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8 Auth Key file's raw contents, BEGIN/END lines included.
APNS_AUTH_KEY=
# "true" for a TestFlight/App Store build; unset or "false" for a Debug
# build (matches the entitlement's own aps-environment).
APNS_PRODUCTION=

# SMS invites (inviting a phone number with no Home Eats account yet, to a
# group or as a friend — see lib/twilio.js's sendInviteSMS). Optional:
# everything works without these, the invite just isn't texted to anyone.
# A Twilio phone number (or Messaging Service SID) capable of sending SMS —
# separate from the Verify service above, which can't send a plain message.
TWILIO_SMS_FROM_NUMBER=
# Shown in the invite text so a non-user knows where to get the app (e.g.
# a TestFlight public link). Leave unset to send the invite text without a
# link.
APP_DOWNLOAD_URL=
